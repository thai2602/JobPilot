# Copy this file to backend/.env for local development.
# Never commit the resulting backend/.env file.

# Server and PostgreSQL
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jobpilot
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me
SPRING_JPA_HIBERNATE_DDL_AUTO=none

# Authentication and external providers
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
GOOGLE_CLIENT_ID=replace_with_google_web_client_id
OPENAI_API_KEY=replace_with_embedding_and_chat_api_key

# pgvector
PGVECTOR_HOST=localhost
PGVECTOR_PORT=5432
PGVECTOR_DATABASE=jobpilot
PGVECTOR_USERNAME=postgres
PGVECTOR_PASSWORD=change_me
PGVECTOR_HR_TABLE=rag_hr_embeddings
PGVECTOR_JOB_TABLE=rag_job_embeddings
PGVECTOR_HISTORICAL_JOB_TABLE=rag_historical_job_embeddings

# Legacy/static RAG ingestion
RAG_IMPORT_LEGACY_JSON=false

# Retrieval and reranker
RAG_HR_MAX_CANDIDATES=24
RAG_HR_MIN_SCORE=0.60
RAG_HR_MAX_RERANKED=8
RAG_JOB_MAX_CANDIDATES=18
RAG_JOB_MIN_SCORE=0.55
RAG_JOB_MAX_RERANKED=6
RAG_HISTORICAL_MAX_CANDIDATES=24
RAG_HISTORICAL_MIN_SCORE=0.50
RAG_HISTORICAL_MAX_RERANKED=8
RAG_HYBRID_ENABLED=true
RAG_HYBRID_LEXICAL_MAX_CANDIDATES=24
RAG_HYBRID_RRF_K=60
RAG_HYBRID_VECTOR_WEIGHT=1.0
RAG_HYBRID_LEXICAL_WEIGHT=1.2
RAG_ROUTER_SCORE_MARGIN=1
RAG_MERGED_MAX_RESULTS=10
RAG_RERANKER_ENABLED=true
RAG_RERANKER_URL=http://localhost:8000/rerank
RAG_RERANKER_CONNECT_TIMEOUT_MS=1500
RAG_RERANKER_READ_TIMEOUT_MS=2500

# Job RAG reads active jobs from public.jobs and joins public.companies
RAG_INCREMENTAL_ENABLED=false
RAG_INCREMENTAL_RUN_ON_START=false
RAG_INCREMENTAL_BATCH_SIZE=64
RAG_INCREMENTAL_DELETE_STALE=true
RAG_INCREMENTAL_ALLOW_EMPTY_SOURCE=false
RAG_INCREMENTAL_SOURCE_SCHEMA=public
RAG_INCREMENTAL_JOB_TABLE=jobs
RAG_INCREMENTAL_COMPANY_TABLE=companies

RAG_HISTORICAL_ENABLED=false
RAG_HISTORICAL_RUN_ON_START=false
RAG_HISTORICAL_BATCH_SIZE=64
RAG_HISTORICAL_DELETE_STALE=true
RAG_HISTORICAL_ALLOW_EMPTY_SOURCE=false

# crawler.* -> public.* -> incremental RAG pipeline
CRAWLER_PIPELINE_ENABLED=false
CRAWLER_PIPELINE_RUN_ON_START=false
CRAWLER_PIPELINE_CRON=0 */15 * * * *
CRAWLER_PIPELINE_SYNC_RAG=true
CRAWLER_SOURCE_SCHEMA=crawler
CRAWLER_COMPANY_TABLE=companies
CRAWLER_JOB_TABLE=jobs
CRAWLER_DEFAULT_SOURCE=crawler
